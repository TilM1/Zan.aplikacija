# ---------------------------------------------------------------------------
# ZAN CRM environment variables. Copy to .env.local and fill in.
# NEVER commit real values. .env* files (except this one) are git-ignored.
# ---------------------------------------------------------------------------

# Public (browser-safe) — Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY — secret key (sb_secret_...) or legacy service_role key.
# Never prefix with NEXT_PUBLIC_. Used only by server actions / route handlers.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Seed/cleanup scripts only (local machine): direct Postgres connection string
# Supabase Dashboard → Connect → Session pooler. Not needed on Vercel.
# SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
